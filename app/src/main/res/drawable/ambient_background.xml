<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_background" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <gradient
