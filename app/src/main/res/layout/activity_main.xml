<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ambient_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/theme_accent"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:fontFamily="sans"
            android:maxLines="1" />

        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/description"
            android:textColor="@color/theme_text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="sans"
            android:maxLines="2" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="26dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/imageView1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/preview_p" />

        </FrameLayout>

        <Button
            android:id="@+id/applyButton"
            android:layout_width="230dp"
            android:layout_height="54dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/apply_button"
            android:text="@string/apply"
            android:textColor="@color/theme_button_text"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="sans"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>